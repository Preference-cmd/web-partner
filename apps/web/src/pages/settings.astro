---
import PageShell from "../layouts/PageShell.astro";
---
<PageShell title="设置 · 伴侣小生命">
  <h1>设置</h1>
  <p class="sub">连接、外观与数据。设置存在本机浏览器，key 只在当前会话有效。</p>

  <section>
    <h2>连接</h2>
    <div class="row"><span class="label">端点</span><span class="value">未配置</span></div>
    <div class="row"><span class="label">模型</span><span class="value">—</span></div>
    <div class="row"><span class="label">API key</span><span class="value">—</span></div>
    <div class="row"><span class="label">直连本机模型</span><span class="value">关闭</span></div>
  </section>

  <section>
    <h2>模式</h2>
    <div class="row"><span class="label">当前模式</span><span class="value on">演示模式</span></div>
    <div class="row"><span class="label">强制演示</span><span class="value">关闭</span></div>
  </section>

  <section>
    <h2>外观</h2>
    <div class="row"><span class="label">灯光主题</span><span class="value">冷夜空</span></div>
    <div class="row"><span class="label">减少动效</span><span class="value">跟随系统</span></div>
    <div class="row"><span class="label">面板透明度</span><span class="value">0.62</span></div>
  </section>

  <section>
    <h2>数据</h2>
    <div class="row"><span class="label">清空历史</span><span class="value">—</span></div>
    <div class="row"><span class="label">清空密钥</span><span class="value">—</span></div>
    <div class="row"><span class="label">清空设置</span><span class="value">—</span></div>
  </section>

  <section>
    <h2>关于</h2>
    <div class="row"><span class="label">版本</span><span class="value">0.1.0</span></div>
    <div class="row"><span class="label">素材许可</span><span class="value">CC BY-NC-SA 4.0</span></div>
  </section>
</PageShell>
