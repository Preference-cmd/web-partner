---
interface Props {
  active?: "chat" | "settings";
  license?: boolean;
}
const { active = "chat", license = true } = Astro.props;
---
<aside class="sidebar">
  <div class="sidebar-inner">
    <div class="brand">
      <div class="mark"></div>
      <b>伴侣小生命</b>
      <span class="ver">0.1</span>
    </div>
    <a class="newchat" href="/">＋ 新对话</a>
    <nav class="nav">
      <a class:list={[{ on: active === "chat" }]} href="/">◍ 对话</a>
      <a class:list={[{ on: active === "settings" }]} href="/settings">⚙ 设置</a>
    </nav>
    <div class="group">当前对话</div>
    <div class="conv">
      <div class="t">今天有点累，想早点睡</div>
      <div class="s">刚刚 · 演示模式</div>
    </div>
    <div class="spacer"></div>
    <div class="side-foot">
      <span class="mode"><span class="dot"></span>演示模式</span>
      <div class="user"><div class="avatar"></div>Pref2rence</div>
      {license && (
        <div class="license">非官方、非商业演示<br />角色素材 CC BY-NC-SA 4.0</div>
      )}
    </div>
  </div>
</aside>
