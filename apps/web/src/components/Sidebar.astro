---
interface Props {
  active?: "chat" | "settings";
  license?: boolean;
}
const { active = "chat", license = true } = Astro.props;
---
<aside class="sidebar">
  <div class="sidebar-inner">
    <div class="brand">
      <div class="mark"></div>
      <b>伴侣小生命</b>
      <span class="ver">0.1</span>
    </div>
    <a class="newchat" href="/">＋ 新对话</a>
    <nav class="nav">
      <a class:list={[{ on: active === "chat" }]} href="/">◍ 对话</a>
      <a class:list={[{ on: active === "settings" }]} href="/settings">⚙ 设置</a>
    </nav>
    <div class="group">本机对话</div>
    <div class="conv">
      <div class="t">历史保存在这台设备</div>
      <div class="s">最多 100 条 · 自动恢复</div>
    </div>
    <div class="spacer"></div>
    <div class="side-foot">
      <span class="mode" data-side-mode data-mode="demo">
        <span class="dot"></span>
        <span class="mode-text">演示模式</span>
      </span>
      <div class="user"><div class="avatar"></div>Pref2rence</div>
      {license && (
        <div class="license">非官方、非商业演示<br />角色素材 CC BY-NC-SA 4.0</div>
      )}
    </div>
  </div>
</aside>
<button class="scrim" id="scrim" type="button" aria-label="收起侧边栏"></button>

<script>
  import { applyModeChip, describeMode, loadSettings, readApiKey } from "../lib/chat/settings";

  // The chip is static HTML; the mode lives in storage, so it is read on every page load.
  function syncMode(): void {
    const mode = describeMode(
      loadSettings(window.localStorage),
      readApiKey(window.sessionStorage, window.localStorage),
    ).mode;
    applyModeChip(document, mode);
  }

  document.addEventListener("astro:page-load", () => {
    syncMode();
    document.getElementById("scrim")?.addEventListener("click", () => {
      document.body.classList.add("sidebar-off");
    });
  });
  syncMode();
</script>
