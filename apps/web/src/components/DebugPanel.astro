---
---
<aside class="right" id="debug-panel" aria-label="调试面板">
  <div class="right-inner">
    <div class="r-head">
      <b>调试面板</b>
      <button class="chip" id="btn-close" type="button">收起</button>
    </div>
    <div class="r-body">
      <div class="card">
        <h4>状态</h4>
        <div class="kv"><span>情绪</span><span>sleepy · 3</span></div>
        <div class="kv"><span>mood</span><span>0.62</span></div>
        <div class="kv"><span>渲染器</span><span>canvas2d</span></div>
        <div class="kv"><span>FPS / DPR</span><span>60 / 2</span></div>
      </div>
      <div class="card">
        <h4>控制</h4>
        <div class="chips">
          <button class="chip" type="button">待机</button>
          <button class="chip" type="button">开心</button>
          <button class="chip" type="button">害羞</button>
          <button class="chip on" type="button">犯困</button>
        </div>
      </div>
      <div class="card">
        <h4>灯光主题</h4>
        <div class="chips">
          <button class="chip on" type="button">冷夜空</button>
          <button class="chip" type="button">暖黄昏</button>
          <button class="chip" type="button">深夜</button>
          <button class="chip" type="button">清晨</button>
        </div>
      </div>
      <div class="card">
        <h4>日志</h4>
        <div class="logs">
          <div><b>23:58</b> 用户 · 今天好累，想睡觉</div>
          <div><b>23:58</b> 演示 · 模板回复</div>
          <div><b>23:58</b> 系统 · 情绪 → sleepy</div>
          <div><b>23:59</b> 调试 · 灯光 → 深夜</div>
        </div>
      </div>
    </div>
  </div>
</aside>
