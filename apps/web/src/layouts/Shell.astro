---
import { ClientRouter } from "astro:transitions";
import DebugPanel from "../components/DebugPanel";
import Sidebar from "../components/Sidebar";
import "../styles/global.css";

interface Props {
  title?: string;
}
const { title = "伴侣小生命" } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="overflow-hidden">
    <div class="flex h-dvh overflow-hidden">
      <Sidebar client:load />
      <main class="relative flex min-w-0 flex-1 flex-col overflow-hidden">
        <div class="stage-backdrop absolute inset-0"></div>
        <div class="stage-vignette pointer-events-none absolute inset-0"></div>
        <div class="stage-dust pointer-events-none absolute inset-0 overflow-hidden opacity-60">
          <i class="animate-drift absolute top-[30%] left-[18%] size-[3px] rounded-full [animation-delay:-2s]"></i>
          <i class="animate-drift absolute top-[62%] left-[32%] size-[2px] rounded-full [animation-delay:-5s]"></i>
          <i class="animate-drift absolute top-[26%] left-[64%] size-[3px] rounded-full [animation-delay:-1s]"></i>
          <i class="animate-drift absolute top-[58%] left-[74%] size-[2px] rounded-full [animation-delay:-4s]"></i>
          <i class="animate-drift absolute top-[44%] left-[48%] size-[3px] rounded-full [animation-delay:-7s]"></i>
        </div>
        <h1 class="sr-only">伴侣小生命 · 和角色对话</h1>
        <div
          class="stage-figure pointer-events-none absolute left-1/2 aspect-square h-[min(360px,40vh)] -translate-x-1/2 md:h-[min(480px,58vh)]"
          data-character-stage
        >
          <div
            class="stage-aura absolute -bottom-5 left-1/2 h-[180px] w-[420px] -translate-x-1/2 rounded-full blur-[18px]"
          >
          </div>
          <canvas class="stage-canvas" data-character-canvas aria-hidden="true"></canvas>
          <p class="stage-bubble" data-character-bubble data-visible="false" role="status"></p>
          <p class="stage-fallback">角色暂时没有出现</p>
          <button type="button" class="stage-touch" data-stage-touch aria-label="摸摸头"></button>
        </div>
        <slot />
      </main>
      <DebugPanel client:load />
    </div>
    <script>
      import { showBubble } from "../lib/character/bubble";
      import { mountCharacter, type RendererKind } from "../lib/character/renderer";
      import { applyPanelPrefs, loadPanelPrefs } from "../lib/debug/prefs";

      const TOUCH_LINES = ["嗯？", "我在听。", "怎么啦？", "……嗯。"];

      /** Click is a head pat, a held press or Enter is a line; neither steals focus. */
      function wireStageTouch(): void {
        const button = document.querySelector<HTMLButtonElement>("[data-stage-touch]");
        if (!button || button.dataset.wired === "true") return;
        button.dataset.wired = "true";
        button.addEventListener("mousedown", (event) => event.preventDefault());
        let timer: number | undefined;
        let held = false;
        const stop = (): void => {
          if (timer !== undefined) window.clearTimeout(timer);
          timer = undefined;
        };
        const speak = (): void => {
          const line = TOUCH_LINES[Math.floor(Math.random() * TOUCH_LINES.length)] ?? "嗯？";
          showBubble(line);
        };
        button.addEventListener("pointerdown", () => {
          held = false;
          stop();
          timer = window.setTimeout(() => {
            held = true;
            speak();
          }, 500);
        });
        button.addEventListener("pointerup", stop);
        button.addEventListener("pointercancel", stop);
        button.addEventListener("pointerleave", stop);
        button.addEventListener("click", (event) => {
          stop();
          if (held) {
            held = false;
            return;
          }
          // detail 0 is a keyboard activation: say a line instead of a head pat.
          if (event.detail === 0) {
            speak();
            return;
          }
          window.dispatchEvent(new CustomEvent("partner:touch"));
        });
      }

      let dispose: (() => void) | undefined;

      function mount(): void {
        const prefs = loadPanelPrefs(localStorage);
        applyPanelPrefs(document.documentElement, prefs);
        const canvas = document.querySelector<HTMLCanvasElement>("[data-character-canvas]");
        if (!canvas || canvas.dataset.mounted === prefs.renderer) return;
        dispose?.();
        dispose = undefined;
        canvas.dataset.mounted = prefs.renderer;
        dispose = mountCharacter(canvas, { renderer: prefs.renderer }).dispose;
      }

      mount();
      wireStageTouch();
      document.addEventListener("astro:page-load", () => {
        mount();
        wireStageTouch();
      });

      document.addEventListener("astro:before-swap", () => {
        dispose?.();
        dispose = undefined;
      });
      // The panel saves the choice, then asks the stage to pick it up.
      window.addEventListener("partner:renderer", (event) => {
        const detail = (event as CustomEvent<{ renderer?: RendererKind }>).detail;
        if (detail?.renderer) mount();
      });
    </script>
  </body>
</html>
