---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";

interface Props {
  title: string;
  active?: "chat" | "settings";
}
const { title, active = "settings" } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <div class="app">
      <Sidebar active={active} />
      <main class="page">
        <div class="page-inner">
          <slot />
        </div>
      </main>
    </div>
    <button
      class="fbtn"
      id="btn-side"
      type="button"
      title="收起 / 展开侧边栏"
      aria-label="收起或展开侧边栏"
      style="position:fixed;top:14px;right:14px;z-index:40"
    >
      <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
        <path
          d="M2.5 4.5h11M2.5 8h11M2.5 11.5h11"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></path>
      </svg>
    </button>
    <script is:inline>
      document.addEventListener("astro:page-load", () => {
        const body = document.body;
        document.getElementById("btn-side")?.addEventListener("click", () => {
          body.classList.toggle("sidebar-off");
        });
        if (window.matchMedia("(max-width: 900px)").matches) {
          body.classList.add("sidebar-off");
        }
      });
    </script>
  </body>
</html>
