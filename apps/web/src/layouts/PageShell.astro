---
import { ClientRouter } from "astro:transitions";
import Sidebar from "../components/Sidebar";
import "../styles/global.css";

interface Props {
  title: string;
  active?: "chat" | "settings";
  wide?: boolean;
}
const { title, active = "settings", wide = false } = Astro.props;
---

<!doctype html>
<html lang="zh-CN" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <div class="flex h-dvh overflow-hidden">
      <Sidebar client:load active={active} />
      <main class="min-w-0 flex-1 overflow-y-auto">
        <div
          class={`mx-auto w-full px-5 pt-16 pb-16 md:px-8 md:pt-10 ${wide ? "max-w-5xl" : "max-w-2xl"}`}
        >
          <slot />
        </div>
      </main>
    </div>
  </body>
</html>
