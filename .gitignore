# ----- Dependencies -----
node_modules/
.pnpm-store/

# ----- Build output -----
dist/
.wrangler/
.astro/
.output/
*.tsbuildinfo

# ----- Local environment / secrets -----
# `.dev.vars*` is what `wrangler dev` reads; never commit it or a real `.env`.
.env
.env.*
!.env.example
.envrc
.dev.vars
.dev.vars.*

# ----- Test + tooling droppings -----
coverage/
*.log

# ----- Editor / OS -----
.DS_Store
._*
Thumbs.db
desktop.ini
*.sw?
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ----- Machine-local agent material -----
# Path-imported by the agent harness and kept out of the repository: proposals,
# skills and local notes are working material, not project records. A decision
# lives in a proposal; a shipped file states its reason inline instead.
AGENTS.local.md
CLAUDE.local.md
.agents/
# Critique snapshots are working material; the impeccable skill writes them here.
.impeccable/
