# ----- Dependencies -----
node_modules/
.pnpm-store/

# ----- Build output -----
dist/
.wrangler/
.astro/
.output/
*.tsbuildinfo

# ----- Local environment / secrets -----
# `.dev.vars*` is what `wrangler dev` reads; never commit it or a real `.env`.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*

# ----- Test + tooling droppings -----
coverage/
*.log

# ----- Editor / OS -----
.DS_Store
._*
*.sw?
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ----- Machine-local agent material -----
# Path-imported by the agent harness and kept out of the repository: proposals,
# skills and local notes are working material, not project records. Tracked
# decisions live in docs/adr/; never cite .agents/ from shipped files.
AGENTS.local.md
CLAUDE.local.md
.agents/
